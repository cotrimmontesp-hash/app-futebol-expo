# URL do servidor que já está no ar. No celular e no emulador o app chama essa origem.
# Na web publicada, o app usa /api no mesmo domínio (o vercel.json encaminha para este servidor).
EXPO_PUBLIC_API_URL=https://app-futebol-1ric.onrender.com

# Deixe false até existirem credenciais Firebase/FCM (Android), chave APNs (iOS) e projectId do EAS.
# O servidor atual só aceita inscrição Web Push; um token Expo não é enviado para lá.
EXPO_PUBLIC_NATIVE_PUSH_ENABLED=false
